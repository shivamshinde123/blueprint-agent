# Copy to .env and fill in real values. NEVER commit .env.

# --- Model access (OpenRouter) ---
# One key, every model: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional overrides. Browse slugs at https://openrouter.ai/models
# BLUEPRINT_MODEL=anthropic/claude-sonnet-5
# BLUEPRINT_EFFORT=high
# BLUEPRINT_PROVIDERS=anthropic          # pinned upstream routing; "" to let the gateway pick
# BLUEPRINT_ALLOW_PROVIDER_FALLBACK=0    # 1 to permit fallback to another provider
# BLUEPRINT_LLM_BASE_URL=https://openrouter.ai/api/v1

# --- OrangeHRM demo (modern web surface, Layer 1) ---
# Public demo, well-known credentials: Admin / admin123
ORANGEHRM_USERNAME=
ORANGEHRM_PASSWORD=

# --- Guru99 Bank demo (legacy web surface, Layer 2) ---
# Register at https://www.demo.guru99.com/ -> "Demo Login" to get emailed credentials.
# These expire; re-request when replay starts failing at the login step.
GURU99_USERNAME=
GURU99_PASSWORD=

# --- SauceDemo / Swag Labs (modern web surface, Layer 1) ---
# Public demo; credentials are printed on the login page itself.
SAUCEDEMO_USERNAME=
SAUCEDEMO_PASSWORD=
