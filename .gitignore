# ---- Secrets: never commit ----
.env
.env.local
*.pem
*.key

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# ---- Environments ----
.venv/
venv/
env/

# ---- Tooling caches ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- Playwright ----
# Traces/videos/HAR are disabled in code (PLAN.md C12), but belt-and-braces:
playwright-report/
test-results/
*.har
*.webm
*.zip

# ---- Evidence ----
# Artifacts, run logs and the curated screenshots are all deliverables and are
# committed. The targets are public demo sites with no real customer data, so
# the PII concern that would apply to a real banking surface does not apply
# here. On such a surface the screenshots would stay out, because a failure
# screenshot captures whatever is on screen and redaction cannot reach inside
# a PNG.
# Self-healing sidecar patches are run artifacts, not source (PLAN.md C8)
artifacts/heal/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
