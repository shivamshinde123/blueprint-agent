    {
      "step_id": 3,
      "action": "fill",
      "description": "Type the password into the login form.",
      "fragile": false,
      "risk_level": "low",
      "value": "{{auth_password}}",
      "pre_condition": {
        "condition": "element_visible",
        "timeout_ms": 8000,
        "on_fail": "retry",
        "locators": {
          "primary": { "strategy": "accessibility_tree", "available": true,
            "methods": [{ "method": "get_by_placeholder", "value": "Password" }] }
        }
      },
      "locators": {
        "primary": { "strategy": "accessibility_tree", "available": true,
          "methods": [{ "method": "get_by_placeholder", "value": "Password" }] },
        "fallback": {
          "strategy": "screenshot",
          "coordinates": { "x": 812, "y": 385 },
