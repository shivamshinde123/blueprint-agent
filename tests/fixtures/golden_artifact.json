        }
      },
      "post_condition": {
        "condition": "page_contains_text",
        "value": "Records Found",
        "timeout_ms": 8000,
        "on_fail": "retry"
      }
    },
    {
      "step_id": 8,
      "action": "extract",
      "description": "Read the job title and sub unit from the results row.",
      "fragile": false,
      "risk_level": "safe",
      "pre_condition": {
        "condition": "page_contains_text",
        "value": "Records Found",
        "timeout_ms": 8000,
        "on_fail": "hard_failure"
      },
      "extractions": [
        {
          "output_key": "job_title",
          "extract_method": "inner_text",
          "expected_type": "string",
          "required": true,
          "locators": {
            "primary": { "strategy": "accessibility_tree", "available": true,
              "methods": [{ "method": "get_by_role", "role": "cell", "name": "Job Title" }] },
            "fallback": {
              "strategy": "screenshot",
              "region": { "x": 620, "y": 560, "width": 180, "height": 40 },
              "scroll_y": 0,
              "viewport": { "width": 1280, "height": 720 },
              "visual_description": "Job Title column value in the first result row"
            }
          }
        },
        {
          "output_key": "sub_unit",
          "extract_method": "inner_text",
          "expected_type": "string",
          "required": true,
          "locators": {
            "primary": { "strategy": "accessibility_tree", "available": true,
              "methods": [{ "method": "get_by_role", "role": "cell", "name": "Sub Unit" }] },
            "fallback": {
              "strategy": "screenshot",
              "region": { "x": 900, "y": 560, "width": 180, "height": 40 },
