  "business_outcomes": [
    {
      "step_ids": [7, 8],
      "name": "Employee not found",
      "detect": {
        "condition": "page_contains_text",
        "value": "No Records Found",
        "timeout_ms": 4000,
        "on_fail": "retry"
      },
      "outcome_code": "EMPLOYEE_NOT_FOUND",
      "outcome_message": "No employee matched the supplied name.",
      "is_error": false,
      "return_value": { "job_title": null, "sub_unit": null }
    },
    {
      "step_ids": [4],
      "name": "Authentication failed",
      "detect": {
        "condition": "page_contains_text",
        "value": "Invalid credentials",
        "timeout_ms": 4000,
        "on_fail": "retry"
      },
      "outcome_code": "AUTH_FAILED",
      "outcome_message": "The supplied credentials were rejected by OrangeHRM.",
      "is_error": false,
      "return_value": { "job_title": null, "sub_unit": null }
    }
  ],

  "error_map": {
    "_default": {
      "element_not_found": {
        "category": "recoverable",
        "action": "retry",
        "max_retries": 3,
        "retry_wait_ms": 1000,
        "on_exhausted": "escalate_human",
        "capture_screenshot": false
      },
      "checkpoint_failed": {
        "category": "recoverable",
        "action": "retry",
        "max_retries": 2,
        "retry_wait_ms": 1000,
        "on_exhausted": "hard_failure",
        "capture_screenshot": false
      },
      "timeout": {
        "category": "recoverable",
        "action": "retry",
        "max_retries": 2,
        "retry_wait_ms": 2000,
        "on_exhausted": "escalate_human",
        "capture_screenshot": false
      },
      "session_expired": {
        "category": "recoverable",
        "action": "re_login",
        "max_retries": 1,
        "retry_wait_ms": 0,
        "on_exhausted": "escalate_human",
        "capture_screenshot": false
      },
      "wrong_page_state": {
        "category": "hard_failure",
        "action": "stop",
        "capture_screenshot": true,
        "message": "The page was not in the expected state and could not be recovered."
      }
    },
    "step_8": {
      "extraction_empty": {
        "category": "hard_failure",
        "action": "stop",
        "capture_screenshot": true,
        "message": "Result row rendered but the job title or sub unit cell was empty."
      }
    }
  },

