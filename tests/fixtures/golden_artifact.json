    },
    {
      "step_id": 6,
      "action": "fill",
      "description": "Type the employee name into the PIM search box.",
      "fragile": false,
      "risk_level": "safe",
      "value": "{{employee_name}}",
      "pre_condition": {
        "condition": "element_visible",
        "timeout_ms": 8000,
        "on_fail": "retry",
        "locators": {
          "primary": { "strategy": "accessibility_tree", "available": true,
            "methods": [{ "method": "get_by_placeholder", "value": "Type for hints..." }] }
