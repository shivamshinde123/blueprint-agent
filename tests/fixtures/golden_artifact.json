{
  "capability_id": "lookup_employee_profile",
  "version": "1.0.0",
  "schema_version": "1.0.0",
  "description": "Look up an employee in OrangeHRM PIM and return their job title and sub unit.",
  "recorded_by": "agent",
  "created_at": "2026-08-20",
  "surface_type": "modern_web",
  "target": {
    "app_name": "OrangeHRM",
    "url": "https://opensource-demo.orangehrmlive.com",
    "surface_type": "modern_web"
  },

  "input_parameters": {
    "auth_username": { "type": "string", "required": true, "sensitive": true, "description": "OrangeHRM login" },
    "auth_password": { "type": "string", "required": true, "sensitive": true, "description": "OrangeHRM password" },
    "employee_name": { "type": "string", "required": true, "sensitive": false, "description": "Full or partial employee name" }
  },

  "output_schema": {
    "job_title": "string",
    "sub_unit": "string"
  },

  "replay_config": {
    "browser": {
      "viewport": { "width": 1280, "height": 720 },
      "device_scale_factor": 1,
      "is_mobile": false,
      "headless": false,
      "locale": "en-US",
      "timezone_id": "UTC",
      "reduced_motion": "reduce",
      "enforce_strictly": true
    },
    "mode": "strict",
    "default_timeout_ms": 8000,
    "interstitial_probe_timeout_ms": 250,
    "max_retries_per_step": 3,
    "retry_wait_ms": 1000,
    "max_llm_calls_per_replay": 3
  },

  "session_recovery": {
    "detect_conditions": [
      { "condition": "url_contains", "value": "/auth/login", "on_fail": "retry" }
    ],
    "recovery_steps": [
      {
        "action": "fill",
        "value": "{{auth_username}}",
        "locators": {
          "primary": { "strategy": "accessibility_tree", "available": true,
            "methods": [{ "method": "get_by_placeholder", "value": "Username" }] }
        }
      },
      {
        "action": "fill",
        "value": "{{auth_password}}",
        "locators": {
          "primary": { "strategy": "accessibility_tree", "available": true,
            "methods": [{ "method": "get_by_placeholder", "value": "Password" }] }
        }
      },
      {
        "action": "click",
        "locators": {
          "primary": { "strategy": "accessibility_tree", "available": true,
            "methods": [{ "method": "get_by_role", "role": "button", "name": "Login" }] }
        }
      }
    ],
    "recovery_post_condition": {
      "condition": "url_not_contains",
      "value": "/auth/login",
      "timeout_ms": 8000,
      "on_fail": "on_recovery_fail"
    },
    "after_recovery": "restart_from_current_step",
    "max_recovery_attempts": 1,
    "on_recovery_fail": "escalate_human"
  },

  "known_interstitials": [
    {
      "name": "loading_spinner",
      "detect": {
        "condition": "element_visible",
        "timeout_ms": 250,
        "on_fail": "retry",
        "locators": {
          "primary": { "strategy": "accessibility_tree", "available": true,
            "methods": [{ "method": "get_by_role", "role": "progressbar", "name": "Loading" }] }
        }
      },
      "dismiss": {
        "dismiss_action": "wait_for_hidden",
        "timeout_ms": 8000,
        "on_timeout": "hard_failure",
        "locators": {
          "primary": { "strategy": "accessibility_tree", "available": true,
            "methods": [{ "method": "get_by_role", "role": "progressbar", "name": "Loading" }] }
        }
      }
    }
  ],

  "steps": [
    {
      "step_id": 1,
      "action": "navigate",
      "description": "Open the OrangeHRM login page.",
      "fragile": false,
      "risk_level": "safe",
      "pre_condition": null,
      "url": "https://opensource-demo.orangehrmlive.com/web/index.php/auth/login",
      "post_condition": {
        "condition": "url_contains",
        "value": "/auth/login",
        "timeout_ms": 8000,
        "on_fail": "hard_failure"
      }
    },
    {
      "step_id": 2,
      "action": "fill",
      "description": "Type the username into the login form.",
      "fragile": false,
      "risk_level": "low",
      "value": "{{auth_username}}",
      "pre_condition": {
        "condition": "element_visible",
        "timeout_ms": 8000,
        "on_fail": "retry",
        "locators": {
          "primary": { "strategy": "accessibility_tree", "available": true,
            "methods": [{ "method": "get_by_placeholder", "value": "Username" }] }
        }
      },
      "locators": {
        "primary": { "strategy": "accessibility_tree", "available": true,
          "methods": [{ "method": "get_by_placeholder", "value": "Username" }] },
        "fallback": {
          "strategy": "screenshot",
          "coordinates": { "x": 812, "y": 322 },
          "scroll_y": 0,
          "viewport": { "width": 1280, "height": 720 },
          "visual_description": "Username input, first field in the login card on the right"
        }
      },
      "post_condition": {
        "condition": "element_has_value",
        "value": "{{auth_username}}",
        "timeout_ms": 4000,
        "on_fail": "retry",
        "locators": {
          "primary": { "strategy": "accessibility_tree", "available": true,
            "methods": [{ "method": "get_by_placeholder", "value": "Username" }] }
        }
      }
