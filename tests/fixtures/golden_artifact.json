        }
      },
      "post_condition": {
        "condition": "element_has_value",
        "value": "{{employee_name}}",
        "timeout_ms": 4000,
        "on_fail": "retry",
        "locators": {
          "primary": { "strategy": "accessibility_tree", "available": true,
            "methods": [{ "method": "get_by_placeholder", "value": "Type for hints..." }] }
        }
      }
    },
    {
      "step_id": 7,
      "action": "click",
      "description": "Run the employee search.",
      "fragile": false,
      "risk_level": "safe",
      "locators": {
        "primary": { "strategy": "accessibility_tree", "available": true,
          "methods": [
            { "method": "get_by_role", "role": "button", "name": "Search" },
            { "method": "get_by_text", "value": "Search" }
