{
  "capability_id": "add_product_to_cart",
  "version": "1.0.0",
  "schema_version": "1.0.0",
  "description": "Log in to the Swag Labs store, add a named product to the cart, and read back the line item.",
  "recorded_by": "agent",
  "created_at": "2026-08-20",
  "surface_type": "modern_web",
  "target": {
    "app_name": "SauceDemo",
    "url": "https://www.saucedemo.com",
    "surface_type": "modern_web"
  },

  "input_parameters": {
    "auth_username": { "type": "string", "required": true, "sensitive": true, "description": "Store login" },
    "auth_password": { "type": "string", "required": true, "sensitive": true, "description": "Store password" },
    "product_name": { "type": "string", "required": true, "sensitive": false, "description": "Product to add to the cart" }
  },

  "output_schema": {
    "item_name": "string",
    "item_price": "currency"
  },

  "replay_config": {
    "browser": {
      "viewport": { "width": 1280, "height": 720 },
      "device_scale_factor": 1,
      "is_mobile": false,
      "headless": false,
      "locale": "en-US",
      "timezone_id": "UTC",
      "reduced_motion": "reduce",
      "enforce_strictly": true
    },
    "mode": "strict",
    "default_timeout_ms": 8000,
    "interstitial_probe_timeout_ms": 250,
    "max_retries_per_step": 3,
    "retry_wait_ms": 1000,
    "max_llm_calls_per_replay": 3
  },

  "session_recovery": {
    "detect_conditions": [
      { "condition": "url_not_contains", "value": "inventory", "on_fail": "retry" }
    ],
    "recovery_steps": [
      {
        "action": "fill",
        "value": "{{auth_username}}",
        "locators": {
          "primary": { "strategy": "accessibility_tree", "available": true,
            "methods": [{ "method": "get_by_placeholder", "value": "Username" }] }
        }
      },
      {
        "action": "fill",
        "value": "{{auth_password}}",
        "locators": {
          "primary": { "strategy": "accessibility_tree", "available": true,
            "methods": [{ "method": "get_by_placeholder", "value": "Password" }] }
        }
      },
      {
        "action": "click",
        "locators": {
          "primary": { "strategy": "accessibility_tree", "available": true,
            "methods": [{ "method": "get_by_role", "role": "button", "name": "Login" }] }
        }
      }
    ],
    "recovery_post_condition": {
      "condition": "url_not_contains",
      "value": "saucedemo.com/index",
      "timeout_ms": 8000,
      "on_fail": "on_recovery_fail"
    },
    "after_recovery": "restart_from_current_step",
    "max_recovery_attempts": 1,
    "on_recovery_fail": "escalate_human"
  },

  "known_interstitials": [
    {
      "name": "loading_spinner",
      "detect": {
        "condition": "element_visible",
        "timeout_ms": 250,
        "on_fail": "retry",
        "locators": {
          "primary": { "strategy": "accessibility_tree", "available": true,
            "methods": [{ "method": "get_by_role", "role": "progressbar", "name": "Loading" }] }
        }
      },
      "dismiss": {
        "dismiss_action": "wait_for_hidden",
        "timeout_ms": 8000,
        "on_timeout": "hard_failure",
        "locators": {
          "primary": { "strategy": "accessibility_tree", "available": true,
            "methods": [{ "method": "get_by_role", "role": "progressbar", "name": "Loading" }] }
        }
      }
    }
  ],

  "steps": [
    {
      "step_id": 1,
      "action": "navigate",
      "description": "Open the Swag Labs store front.",
      "fragile": false,
      "risk_level": "safe",
      "pre_condition": null,
      "url": "https://www.saucedemo.com/",
      "post_condition": {
        "condition": "page_contains_text",
        "value": "Swag Labs",
        "timeout_ms": 8000,
        "on_fail": "hard_failure"
      }
    },
    {
      "step_id": 2,
      "action": "fill",
      "description": "Type the username into the login form.",
      "fragile": false,
      "risk_level": "low",
      "value": "{{auth_username}}",
      "pre_condition": {
        "condition": "element_visible",
        "timeout_ms": 8000,
        "on_fail": "retry",
        "locators": {
          "primary": { "strategy": "accessibility_tree", "available": true,
            "methods": [{ "method": "get_by_placeholder", "value": "Username" }] }
        }
      },
      "locators": {
        "primary": { "strategy": "accessibility_tree", "available": true,
          "methods": [{ "method": "get_by_placeholder", "value": "Username" }] },
        "fallback": {
          "strategy": "screenshot",
          "coordinates": { "x": 640, "y": 292 },
          "scroll_y": 0,
          "viewport": { "width": 1280, "height": 720 },
          "visual_description": "Username input, first field in the login form"
        }
      },
      "post_condition": {
        "condition": "element_has_value",
        "value": "{{auth_username}}",
        "timeout_ms": 4000,
        "on_fail": "retry",
        "locators": {
          "primary": { "strategy": "accessibility_tree", "available": true,
            "methods": [{ "method": "get_by_placeholder", "value": "Username" }] }
        }
      }
    },
    {
      "step_id": 3,
      "action": "fill",
      "description": "Type the password into the login form.",
      "fragile": false,
      "risk_level": "low",
      "value": "{{auth_password}}",
      "pre_condition": {
        "condition": "element_visible",
        "timeout_ms": 8000,
        "on_fail": "retry",
        "locators": {
          "primary": { "strategy": "accessibility_tree", "available": true,
            "methods": [{ "method": "get_by_placeholder", "value": "Password" }] }
        }
      },
      "locators": {
        "primary": { "strategy": "accessibility_tree", "available": true,
          "methods": [{ "method": "get_by_placeholder", "value": "Password" }] },
        "fallback": {
          "strategy": "screenshot",
          "coordinates": { "x": 640, "y": 342 },
          "scroll_y": 0,
          "viewport": { "width": 1280, "height": 720 },
          "visual_description": "Password input, directly below the username field"
        }
      },
      "post_condition": {
        "condition": "element_has_value",
        "value": "{{auth_password}}",
        "timeout_ms": 4000,
        "on_fail": "retry",
        "locators": {
          "primary": { "strategy": "accessibility_tree", "available": true,
            "methods": [{ "method": "get_by_placeholder", "value": "Password" }] }
        }
      }
    },
    {
      "step_id": 4,
      "action": "click",
      "description": "Submit the login form.",
      "fragile": false,
      "risk_level": "low",
      "locators": {
        "primary": { "strategy": "accessibility_tree", "available": true,
          "methods": [{ "method": "get_by_role", "role": "button", "name": "Login" }] },
        "fallback": {
          "strategy": "screenshot",
          "coordinates": { "x": 640, "y": 400 },
          "scroll_y": 0,
          "viewport": { "width": 1280, "height": 720 },
          "visual_description": "Green Login button below the password field"
        }
      },
      "post_condition": {
        "condition": "url_contains",
        "value": "inventory",
        "timeout_ms": 8000,
        "on_fail": "retry"
      }
    },
    {
      "step_id": 5,
      "action": "click",
      "description": "Open the requested product from the catalogue.",
      "fragile": false,
      "risk_level": "safe",
      "pre_condition": {
        "condition": "url_contains",
        "value": "inventory",
        "timeout_ms": 8000,
        "on_fail": "hard_failure"
      },
      "locators": {
        "primary": { "strategy": "accessibility_tree", "available": true,
          "methods": [{ "method": "get_by_text", "value": "{{product_name}}" }] },
        "fallback": {
          "strategy": "screenshot",
          "coordinates": { "x": 348, "y": 296 },
          "scroll_y": 0,
          "viewport": { "width": 1280, "height": 720 },
          "visual_description": "Product title link in the catalogue grid"
        }
      },
      "post_condition": {
        "condition": "url_contains",
        "value": "inventory-item",
        "timeout_ms": 8000,
        "on_fail": "retry"
      }
    },
    {
      "step_id": 6,
      "action": "click",
      "description": "Add the product to the cart.",
      "fragile": false,
      "risk_level": "low",
      "locators": {
        "primary": { "strategy": "accessibility_tree", "available": true,
          "methods": [{ "method": "get_by_role", "role": "button", "name": "Add to cart" }] },
        "fallback": {
          "strategy": "screenshot",
          "coordinates": { "x": 780, "y": 470 },
          "scroll_y": 0,
          "viewport": { "width": 1280, "height": 720 },
          "visual_description": "Add to cart button beneath the product price"
        }
      },
      "post_condition": {
        "condition": "page_contains_text",
        "value": "Remove",
        "timeout_ms": 8000,
        "on_fail": "retry"
      }
    },
    {
      "step_id": 7,
      "action": "click",
      "description": "Open the shopping cart.",
      "fragile": false,
      "risk_level": "safe",
      "locators": {
        "primary": { "strategy": "accessibility_tree", "available": true,
          "methods": [
            { "method": "get_by_role", "role": "link", "name": "shopping cart" },
            { "method": "get_by_text", "value": "shopping cart" }
          ] },
        "fallback": {
          "strategy": "screenshot",
          "coordinates": { "x": 1218, "y": 44 },
          "scroll_y": 0,
          "viewport": { "width": 1280, "height": 720 },
          "visual_description": "Cart icon in the top right of the header"
        }
      },
      "post_condition": {
        "condition": "url_contains",
        "value": "cart",
        "timeout_ms": 8000,
        "on_fail": "retry"
      }
    },
    {
      "step_id": 8,
      "action": "extract",
      "description": "Read the line item name and price from the cart.",
      "fragile": false,
      "risk_level": "safe",
      "pre_condition": {
        "condition": "url_contains",
        "value": "cart",
        "timeout_ms": 8000,
        "on_fail": "hard_failure"
      },
      "extractions": [
        {
          "output_key": "item_name",
          "extract_method": "inner_text",
          "expected_type": "string",
          "required": true,
          "locators": {
            "primary": { "strategy": "accessibility_tree", "available": true,
              "methods": [{ "method": "get_by_text", "value": "{{product_name}}" }] },
            "fallback": {
              "strategy": "screenshot",
              "region": { "x": 250, "y": 300, "width": 300, "height": 30 },
              "scroll_y": 0,
              "viewport": { "width": 1280, "height": 720 },
              "visual_description": "Line item title in the cart list"
            }
          }
        },
        {
          "output_key": "item_price",
          "extract_method": "inner_text",
          "expected_type": "currency",
          "required": true,
          "pattern": "\\$[\\d,.]+",
          "locators": {
            "primary": { "strategy": "accessibility_tree", "available": true,
              "methods": [{ "method": "get_by_text", "pattern": "\\$[\\d,.]+" }] },
            "fallback": {
              "strategy": "screenshot",
              "region": { "x": 250, "y": 360, "width": 120, "height": 30 },
              "scroll_y": 0,
              "viewport": { "width": 1280, "height": 720 },
              "visual_description": "Line item price in the cart list"
            }
          }
        }
      ],
      "post_condition": {
        "condition": "all_extractions_non_empty",
        "timeout_ms": 4000,
        "on_fail": "hard_failure"
      }
    }
  ],

  "business_outcomes": [
    {
      "step_ids": [7, 8],
      "name": "Cart is empty",
      "detect": {
        "condition": "page_contains_text",
        "value": "Your cart is empty",
        "timeout_ms": 4000,
        "on_fail": "retry"
      },
      "outcome_code": "CART_EMPTY",
      "outcome_message": "The product was not added, so the cart holds no line item.",
      "is_error": false,
      "return_value": { "item_name": null, "item_price": null }
    },
    {
      "step_ids": [4],
      "name": "Authentication failed",
      "detect": {
        "condition": "page_contains_text",
        "value": "Username and password do not match",
        "timeout_ms": 4000,
        "on_fail": "retry"
      },
      "outcome_code": "AUTH_FAILED",
      "outcome_message": "The supplied credentials were rejected by the store.",
      "is_error": false,
      "return_value": { "item_name": null, "item_price": null }
    }
  ],

  "error_map": {
    "_default": {
      "element_not_found": {
        "category": "recoverable",
        "action": "retry",
        "max_retries": 3,
        "retry_wait_ms": 1000,
        "on_exhausted": "escalate_human",
        "capture_screenshot": false
      },
      "checkpoint_failed": {
        "category": "recoverable",
        "action": "retry",
        "max_retries": 2,
        "retry_wait_ms": 1000,
        "on_exhausted": "hard_failure",
        "capture_screenshot": false
      },
      "timeout": {
        "category": "recoverable",
        "action": "retry",
        "max_retries": 2,
        "retry_wait_ms": 2000,
        "on_exhausted": "escalate_human",
        "capture_screenshot": false
      },
      "session_expired": {
        "category": "recoverable",
        "action": "re_login",
        "max_retries": 1,
        "retry_wait_ms": 0,
        "on_exhausted": "escalate_human",
        "capture_screenshot": false
      },
      "wrong_page_state": {
        "category": "hard_failure",
        "action": "stop",
        "capture_screenshot": true,
        "message": "The page was not in the expected state and could not be recovered."
      }
    },
    "step_8": {
      "extraction_empty": {
        "category": "hard_failure",
        "action": "stop",
        "capture_screenshot": true,
        "message": "The cart rendered but a line item field was empty."
      }
    }
  },

  "self_healing": {
    "enabled": false
  },

  "provenance": {
    "source_run_id": "fixture-golden-0001",
    "model_id": "anthropic/claude-sonnet-5",
    "notes": "Hand-written golden fixture for schema tests; not produced by a real discovery run."
  }
}
