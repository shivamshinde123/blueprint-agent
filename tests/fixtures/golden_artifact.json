        }
      },
      "post_condition": {
        "condition": "element_has_value",
        "value": "{{auth_password}}",
        "timeout_ms": 4000,
        "on_fail": "retry",
        "locators": {
          "primary": { "strategy": "accessibility_tree", "available": true,
            "methods": [{ "method": "get_by_placeholder", "value": "Password" }] }
        }
      }
    },
    {
      "step_id": 4,
      "action": "click",
      "description": "Submit the login form.",
      "fragile": false,
      "risk_level": "low",
      "locators": {
        "primary": { "strategy": "accessibility_tree", "available": true,
          "methods": [{ "method": "get_by_role", "role": "button", "name": "Login" }] },
        "fallback": {
          "strategy": "screenshot",
          "coordinates": { "x": 812, "y": 452 },
          "scroll_y": 0,
          "viewport": { "width": 1280, "height": 720 },
          "visual_description": "Orange Login button below the password field"
        }
      },
      "post_condition": {
        "condition": "url_contains",
        "value": "/dashboard",
        "timeout_ms": 8000,
        "on_fail": "retry"
